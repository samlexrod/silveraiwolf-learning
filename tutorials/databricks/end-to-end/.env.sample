# databricks/end-to-end — non-secret local config (copy to .env; .env is gitignored).
# Fill from the /setup connect stage. These two are NOT secret (host + warehouse id).
DATABRICKS_HOST=https://<your-workspace>.cloud.databricks.com
DATABRICKS_WAREHOUSE_ID=<starter-warehouse-id>

# Your PAT — DO NOT put it here / commit it. Export it in your shell instead:
#   export DATABRICKS_TOKEN="dapi..."
# (dbt + scripts read DATABRICKS_TOKEN from the environment.)

# --- lakebase/ + lakehouse/ tracks append these (non-secret) as you go ---
# LAKEBASE_HOST=<endpoint-host>                 # from the Lakebase Connect dialog (provision stage)
# LAKEBASE_DB=databricks_postgres               # default Lakebase database
# LAKEBASE_USER=<your-databricks-email>         # your identity = the Postgres role (OAuth auth)
# LAKEBASE_UC_CATALOG=lakebase_silverline_oltp           # the registered Lakebase catalog name (ingest stage)
#
# Secrets — export in your shell, never commit:
#   export PGPASSWORD="<minted Lakebase OAuth token>"     # Postgres password for psycopg (seed/simulate)
#   export LAKEBASE_API="<data-api-base-url>"             # data-api stage (REST)
#   export LAKEBASE_API_TOKEN="<data-api-token>"          # data-api stage (REST auth)
