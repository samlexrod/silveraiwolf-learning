# Silverline Explorer — server config. Copy to .env and fill from the tutorial's connect/provision stages.
# NO secrets here: the Lakebase password is a short-lived OAuth token the server mints on demand
# via the Databricks CLI (the `free` profile), so only non-secret connection info lives in .env.

PORT=4000

# Lakebase (from the provision stage — see tutorials/databricks/end-to-end/.env)
LAKEBASE_HOST=ep-xxxxxxxx.database.us-east-2.cloud.databricks.com
LAKEBASE_PORT=5432
LAKEBASE_DB=databricks_postgres
LAKEBASE_USER=you@example.com

# Endpoint resource path used to mint the DB credential token
LAKEBASE_EP=projects/silverline-oltp/branches/production/endpoints/primary

# --- AUTH MODE ---
# Local dev (default): mint tokens via the Databricks CLI (your user OAuth, `free` profile).
DATABRICKS_PROFILE=free
# Optional: full path to the databricks CLI if it isn't on PATH (Windows winget install)
# DATABRICKS_BIN=C:\Users\you\AppData\Local\Microsoft\WinGet\Packages\...\databricks.exe

# Docker / any machine (headless): service-principal M2M. If SP_CLIENT_ID + SP_SECRET are set,
# the server uses client_credentials instead of the CLI, and connects as the SP (no user login).
# Get these from the data-api stage's `silverline` secret scope.
DATABRICKS_HOST=https://dbc-xxxxxxxx.cloud.databricks.com
# SP_CLIENT_ID=
# SP_SECRET=

# Optional: paste a pre-minted token to bypass minting entirely (expires ~1h)
# LAKEBASE_TOKEN=
